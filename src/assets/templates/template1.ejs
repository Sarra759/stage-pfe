<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="bootstrap.css">
    <link rel="stylesheet" href="printings.css">
    <link rel="stylesheet" href="template1.css">
</head>

<body>
<% const doc = typeof quotation !== 'undefined' ? quotation : invoice; %>

<header class="clearfix">
    <div id="logo">
        <img src="<%= logo %>">
    </div>

    <h1 id="document-type">
        <%= meta.type %> N° <%= doc.sequential %>
    </h1>

    <div id="company" class="clearfix">
        <div><%= doc.cabinet.enterpriseName %></div>

        <div>
            <%= doc.cabinet.address.address %>,<br/>
            <%= doc.cabinet.address.zipcode %>
            <%= doc.cabinet.address.region %>,
            <%= doc.cabinet.address.country.alpha2code %>
        </div>
        <div><%= doc.cabinet.phone %></div>
        <div><a href="<%= doc.cabinet.email %>"><%= doc.cabinet.email %></a></div>
    </div>
    
    <div id="project">
        <div><span>CLIENT</span> <%= doc.firm.name %></div>

        <% if (meta.showDeliveryAddress) { %>
        <div>
            <span>ADRESSE DE LIVRAISON</span><br>
            <%= doc.firm.deliveryAddress.address %>,
            <%= doc.firm.deliveryAddress.zipcode %>
            <%= doc.firm.deliveryAddress.region %>,
            <%= doc.firm.deliveryAddress.country.alpha2code %>
        </div>
        <% } %>

        <% if (meta.showInvoiceAddress) { %>
        <div>
            <span>ADRESSE DE FACTURATION</span><br>
            <%= doc.firm.invoicingAddress.address %>,
            <%= doc.firm.invoicingAddress.zipcode %>
            <%= doc.firm.invoicingAddress.region %>,
            <%= doc.firm.invoicingAddress.country.alpha2code %>
        </div>
        <% } %>

        <div><span>DATE</span> <%= doc.date %></div>
        <div><span>ÉCHÉANCE</span> <%= doc.dueDate %></div>
        <div><span>OBJET</span> <%= doc.object %></div>
    </div>
</header>

<main>
<table class="table table-striped">
<thead>
<tr>
<th>#</th>
<th>Nom</th>
<th>Description</th>
<th>Quantité</th>
<th>P.U</th>
<th>Remise</th>
<th>HT</th>
<th>Taxes</th>
<th>TTC</th>
</tr>
</thead>

<tbody>
<% let counter = 1; %>
<% doc.articleInvoiceEntries?.forEach(function(entry) { %>

<tr>
<td># <%= counter %></td>
<td><%= entry.article.title %></td>
<td><%= entry.article.description %></td>
<td><%= entry.quantity %></td>

<td>
    <%= entry.unit_price %> <%= doc.currency.symbol %>
</td>

<td>
    <%= entry.discount %>
    <% if (entry.discount_type == "PERCENTAGE") { %> %
    <% } else { %> <%= doc.currency.symbol %>
    <% } %>
</td>

<td>
    <%= entry.subTotal %> <%= doc.currency.symbol %>
</td>

<td>
<% if (entry.articleInvoiceEntryTaxes?.length > 0) { %>
<ul>
<% entry.articleInvoiceEntryTaxes.forEach(function(taxEntry) { %>
<li><%= taxEntry.tax.label %> (<%= taxEntry.tax.rate * 100 %> %)</li>
<% }); %>
</ul>
<% } else { %>
<span>Aucune taxe applicable</span>
<% } %>
</td>

<td>
    <%= entry.total %> <%= doc.currency.symbol %>
</td>
</tr>

<% counter++; %>
<% }); %>
</tbody>
</table>

<div class="container">
<div class="row">
<div class="col-md-6 offset-md-6">
<table class="table">

<tr>
<td>Total HT</td>
<td><%= doc.subTotal %> <%= doc.currency.symbol %></td>
</tr>

<% doc.taxSummary?.forEach(function(tax) { %>
<tr>
<td><%= tax.label %> (<%= tax.rate %>%)</td>
<td><%= tax.amount.toFixed(doc.currency.digitAfterComma) %> <%= doc.currency.symbol %></td>
</tr>
<% }) %>

<tr>
<td>Remise</td>
<td>
<%= doc.discount %>
<% if (doc.discount_type == "PERCENTAGE") { %> %
<% } else { %> <%= doc.currency.symbol %>
<% } %>
</td>
</tr>

<% if (doc.taxStamp) { %>
<tr>
<td>Timbre Fiscale</td>
<td><%= doc.taxStamp %> <%= doc.currency.symbol %></td>
</tr>
<% } %>

<tr>
<td>Montant à payer</td>
<td><%= doc.total %> <%= doc.currency.symbol %></td>
</tr>

</table>
</div>
</div>
</div>

<div class="row mt-5">
<div class="col-8">
<div>Conditions Générales:</div>
<div class="notice"><%= doc.generalConditions %></div>
</div>

<div class="col-4 border text-center">
<strong>Cachet & Signature</strong>
</div>
</div>

</main>
</body>
</html>